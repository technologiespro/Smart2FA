{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Smart2FA-OXID",
  "version": "2.0.0",
  "identifier": "io.smartholdem.2fa",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:6001",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Smart2FA-OXID",
        "width": 420,
        "height": 780,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
